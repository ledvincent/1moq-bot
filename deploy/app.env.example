# Settings of the production stack: copy to $MOQ_ETC/app.env
# (/etc/1moq/app.env on the server, .deploy-local/etc/app.env on the developer's machine).
# Placeholders only: never write a real value in this file.

# PostgreSQL password, hex so it needs no escaping: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Public address of the service, without https:// (localhost on the developer's machine)
APP_DOMAIN=app.1moq.example
# Contact address given to the certificate authority
ACME_EMAIL=change-me@app.1moq.example
