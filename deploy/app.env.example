# Settings of the production stack: copy to $MOQ_ETC/app.env
# (/etc/1moq/app.env on the server, .deploy-local/etc/app.env on the developer's machine).
# Placeholders only: never write a real value in this file.

# PostgreSQL password, hex so it needs no escaping: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
# Public address of the service, without https:// (localhost on the developer's machine)
APP_DOMAIN=app.1moq.example
# Contact address given to the certificate authority
ACME_EMAIL=change-me@app.1moq.example
# Key of the keyed hashes (do-not-contact list, seen businesses), at least 32 characters:
# openssl rand -base64 48
# Part of the data: never change it, and back it up apart from the database.
MATCH_HASH_KEY=change-me
# Optional: the Google service account's JSON key, base64-encoded on one line:
# base64 -w0 service-account.json   (okf/integrations/google-sheets.md says how to get the key)
# Delete this line to run without Google access: the sheet sync then fails with that reason.
GOOGLE_SERVICE_ACCOUNT_KEY=change-me
